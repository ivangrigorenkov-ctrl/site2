<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ПОВЕРХНОСТИ — Студия премиальной поклейки обоев</title>
<meta name="description" content="Поклейка обоев премиум-класса в Москве и области. Флизелин, винил, фотообои, фрески, текстиль. Гарантия 5 лет.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Inter:wght@400;500;800;900&display=swap">

<script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/lenis@1.3.13/dist/lenis.min.js"></script>
<script type="importmap">
{ "imports": { "three": "https://unpkg.com/three@0.183/build/three.module.js" } }
</script>

<style>
:root {
  --void-black: #050508;
  --void-dark: #0A0A0F;
  --void-card: #0E0E14;
  --neon-cyan: #00D4FF;
  --neon-blue: #4D9FFF;
  --neon-soft: #9DC4FF;
  --ink-soft: rgba(255,255,255,0.7);
  --ink-mute: rgba(255,255,255,0.5);
  --ink-faint: rgba(255,255,255,0.3);
  --hair: rgba(255,255,255,0.08);
  --hair-mid: rgba(255,255,255,0.12);
  --hair-strong: rgba(255,255,255,0.2);
  --ease-quiet: cubic-bezier(.22, 1, .36, 1);
  --ease-precise: cubic-bezier(.4, 0, .2, 1);
  --ease-emphasis: cubic-bezier(.16, 1, .3, 1);
}

* { margin: 0; padding: 0; box-sizing: border-box; }
html { background: var(--void-black); }
body {
  font-family: 'Inter', sans-serif;
  background: var(--void-black);
  color: #fff;
  overflow-x: hidden;
  cursor: none;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}
a { color: inherit; text-decoration: none; cursor: none; }
button { font-family: inherit; cursor: none; background: none; border: none; color: inherit; }
input, select, textarea { font-family: inherit; cursor: none; }
::selection { background: var(--neon-cyan); color: var(--void-black); }

/* Custom cursor */
#custom-cursor {
  position: fixed; top: 0; left: 0;
  width: 12px; height: 12px;
  border-radius: 50%;
  background: var(--neon-cyan);
  mix-blend-mode: difference;
  pointer-events: none;
  z-index: 9999;
  will-change: transform;
  transition: width .3s var(--ease-quiet), height .3s var(--ease-quiet), opacity .3s var(--ease-quiet);
}
#custom-cursor.hover { width: 48px; height: 48px; opacity: 0.5; }

@media (hover: none), (pointer: coarse) {
  body, a, button, input, select, textarea { cursor: auto; }
  #custom-cursor { display: none !important; }
}

/* Particle canvas */
#particle-canvas {
  position: fixed; top: 0; left: 0;
  width: 100%; height: 100%;
  z-index: 0;
  pointer-events: none;
  opacity: 0.7;
}

main { position: relative; z-index: 2; }
section { position: relative; }
.container { max-width: 1400px; margin: 0 auto; padding: 0 2rem; position: relative; z-index: 2; }
.container-narrow { max-width: 920px; margin: 0 auto; padding: 0 2rem; position: relative; z-index: 2; }

.section-label {
  font: 400 11px/1 'JetBrains Mono', monospace;
  letter-spacing: 0.25em;
  text-transform: uppercase;
  color: var(--neon-cyan);
  display: inline-flex; align-items: center; gap: 0.75rem;
  margin-bottom: 1.5rem;
}
.section-label::before {
  content: ''; display: inline-block;
  width: 24px; height: 1px;
  background: var(--neon-cyan);
}

/* Top nav */
#topnav {
  position: fixed; top: 0; left: 0; right: 0;
  z-index: 100;
  padding: 1.1rem 2rem;
  display: flex; align-items: center; justify-content: space-between;
  backdrop-filter: blur(20px) saturate(140%);
  -webkit-backdrop-filter: blur(20px) saturate(140%);
  background: rgba(5,5,8,0.6);
  border-bottom: 1px solid var(--hair);
}
#topnav .logo {
  font: 700 13px 'JetBrains Mono', monospace;
  letter-spacing: 0.15em;
  color: #fff;
  display: flex; align-items: center; gap: 0.5rem;
}
.logo-dot {
  width: 8px; height: 8px;
  background: var(--neon-cyan);
  border-radius: 50%;
  box-shadow: 0 0 12px var(--neon-cyan);
}
#topnav .nav-links {
  display: flex; gap: 2.25rem;
  list-style: none;
}
#topnav .nav-links a {
  font: 400 11px 'JetBrains Mono', monospace;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--ink-mute);
  position: relative;
  padding: 0.5rem 0;
  transition: color 0.3s var(--ease-quiet);
}
#topnav .nav-links a::after {
  content: ''; position: absolute; left: 0; bottom: 0;
  width: 0; height: 1px;
  background: var(--neon-cyan);
  transition: width 0.4s var(--ease-quiet);
}
#topnav .nav-links a:hover, #topnav .nav-links a.active { color: #fff; }
#topnav .nav-links a:hover::after, #topnav .nav-links a.active::after { width: 100%; }

#topnav .nav-cta {
  font: 400 11px 'JetBrains Mono', monospace;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  padding: 0.7rem 1.2rem;
  border: 1px solid var(--neon-cyan);
  color: var(--neon-cyan);
  background: transparent;
  transition: background 0.3s var(--ease-quiet), color 0.3s var(--ease-quiet);
}
#topnav .nav-cta:hover { background: var(--neon-cyan); color: var(--void-black); }

@media (max-width: 920px) { #topnav .nav-links { display: none; } }

/* Hero */
#hero {
  min-height: 100vh;
  display: flex; flex-direction: column; justify-content: center;
  padding: 8rem 2rem 4rem;
  position: relative;
  z-index: 3;
}
.hero-label {
  font: 400 11px/1 'JetBrains Mono', monospace;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: var(--neon-cyan);
  margin-bottom: 2.5rem;
  display: flex; align-items: center; gap: 1rem;
}
.hero-label::before { content: ''; width: 32px; height: 1px; background: var(--neon-cyan); }

#hero-title {
  font: 700 clamp(2rem, 8.5vw, 7.5rem)/0.95 'JetBrains Mono', monospace;
  letter-spacing: -0.04em;
  color: #fff;
  margin-bottom: 2rem;
  word-break: break-word;
}
#hero-title.is-decoding {
  text-shadow: 0 0 20px rgba(0,212,255,0.5), 0 0 40px rgba(0,212,255,0.2);
}

.hero-sub {
  font: 400 clamp(1rem, 1.3vw, 1.2rem)/1.55 'Inter', sans-serif;
  color: var(--ink-soft);
  max-width: 640px;
  margin-bottom: 3rem;
}

.hero-cta-row {
  display: flex; gap: 1.25rem; flex-wrap: wrap;
  margin-bottom: 5rem;
}

.btn {
  font: 400 12px 'JetBrains Mono', monospace;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  padding: 1rem 1.6rem;
  border: 1px solid var(--hair-strong);
  background: transparent;
  color: #fff;
  transition: border-color 0.3s var(--ease-quiet), background 0.3s var(--ease-quiet), color 0.3s var(--ease-quiet);
  display: inline-flex; align-items: center; gap: 0.5rem;
}
.btn:hover { border-color: var(--neon-cyan); }
.btn.primary {
  background: var(--neon-cyan);
  color: var(--void-black);
  border-color: var(--neon-cyan);
}
.btn.primary:hover { background: #fff; border-color: #fff; }
.btn .arrow {
  display: inline-block;
  transition: transform 0.3s var(--ease-quiet);
}
.btn:hover .arrow { transform: translateX(4px); }

.hero-stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 2rem;
  border-top: 1px solid var(--hair-mid);
  padding-top: 2rem;
}
.hero-stat .num {
  font: 700 clamp(1.75rem, 4vw, 3.25rem)/1 'JetBrains Mono', monospace;
  letter-spacing: -0.04em;
  color: #fff;
  margin-bottom: 0.5rem;
}
.hero-stat .num .unit { color: var(--neon-cyan); font-size: 0.55em; margin-left: 0.25rem; }
.hero-stat .label {
  font: 400 10px 'JetBrains Mono', monospace;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--ink-mute);
}
@media (max-width: 720px) { .hero-stats { grid-template-columns: repeat(2, 1fr); } }

.hero-scroll {
  position: absolute; bottom: 2rem; left: 2rem;
  font: 400 10px 'JetBrains Mono', monospace;
  letter-spacing: 0.25em;
  text-transform: uppercase;
  color: var(--ink-mute);
  display: flex; align-items: center; gap: 0.75rem;
}
.hero-scroll::after {
  content: ''; width: 1px; height: 32px;
  background: linear-gradient(to bottom, var(--neon-cyan), transparent);
  animation: scroll-pulse 2s var(--ease-quiet) infinite;
}
@keyframes scroll-pulse {
  0%, 100% { opacity: 0.3; transform: scaleY(0.7); }
  50% { opacity: 1; transform: scaleY(1); }
}

/* Vortex section */
#vortex-section {
  height: 100vh;
  position: relative;
  overflow: hidden;
}
#vortex-canvas {
  position: absolute; inset: 0;
  width: 100%; height: 100%;
  z-index: 1;
}
.vortex-overlay {
  position: absolute; inset: 0;
  display: flex; flex-direction: column; justify-content: space-between;
  padding: 5rem 2rem 3rem;
  pointer-events: none;
  z-index: 2;
}
.vortex-overlay > div {
  display: flex; justify-content: space-between; align-items: flex-end;
  gap: 2rem; flex-wrap: wrap;
}
.vortex-overlay h2 {
  font: 800 clamp(1.4rem, 2.6vw, 2.2rem)/1.15 'Inter', sans-serif;
  letter-spacing: -0.02em;
  max-width: 540px;
}
.vortex-hint {
  font: 400 11px 'JetBrains Mono', monospace;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--ink-mute);
}
.vortex-vignette {
  position: absolute; inset: 0;
  background: radial-gradient(ellipse at center, transparent 40%, rgba(5,5,8,0.6) 100%);
  pointer-events: none;
  z-index: 1;
}

/* Manifesto */
#manifesto {
  padding: 12rem 2rem;
}
#manifesto .text {
  font: 400 clamp(1.4rem, 2.8vw, 2.25rem)/1.4 'Inter', sans-serif;
  letter-spacing: -0.01em;
  color: #fff;
  margin-top: 2.5rem;
}
#manifesto .text .word {
  display: inline-block;
  opacity: 0;
  filter: blur(12px) brightness(30%);
  will-change: filter, opacity;
}

/* Section header */
.section-header {
  display: grid;
  grid-template-columns: 1fr 1.5fr;
  gap: 4rem;
  margin-bottom: 5rem;
  align-items: end;
}
.section-header h2 {
  font: 900 clamp(2.25rem, 5.5vw, 4.75rem)/0.95 'Inter', sans-serif;
  letter-spacing: -0.03em;
}
.section-header .lede {
  font: 400 1rem/1.6 'Inter', sans-serif;
  color: var(--ink-soft);
  max-width: 480px;
}
@media (max-width: 880px) {
  .section-header { grid-template-columns: 1fr; gap: 1.5rem; }
}

/* Services */
#services {
  padding: 8rem 2rem;
  border-top: 1px solid var(--hair-mid);
}
.service-row {
  display: grid;
  grid-template-columns: 50px 1.2fr 2fr 180px;
  gap: 2rem;
  padding: 2.25rem 0;
  border-top: 1px solid var(--hair-mid);
  position: relative;
  align-items: center;
  transition: padding 0.5s var(--ease-quiet);
}
.service-row:last-child { border-bottom: 1px solid var(--hair-mid); }
.service-row::before {
  content: ''; position: absolute;
  left: 0; top: 0;
  width: 2px; height: 0;
  background: var(--neon-cyan);
  transition: height 0.6s var(--ease-quiet);
}
.service-row:hover::before { height: 100%; }
.service-row:hover { padding-left: 1.5rem; }
.service-row .num {
  font: 400 13px 'JetBrains Mono', monospace;
  color: var(--ink-faint);
}
.service-row h3 {
  font: 800 1.4rem/1.2 'Inter', sans-serif;
  letter-spacing: -0.02em;
  transition: color 0.4s var(--ease-quiet);
}
.service-row:hover h3 { color: var(--neon-cyan); }
.service-row p {
  font: 400 0.92rem/1.55 'Inter', sans-serif;
  color: var(--ink-mute);
  transition: color 0.4s var(--ease-quiet);
}
.service-row:hover p { color: var(--ink-soft); }
.service-row .price {
  font: 400 14px 'JetBrains Mono', monospace;
  text-align: right;
}
.service-row .price .val {
  color: #fff;
  font-size: 1.2rem;
  font-weight: 700;
}
.service-row .price .unit {
  color: var(--ink-mute);
  font-size: 0.8em;
  display: block;
  margin-top: 0.15rem;
}
.service-row .order-btn {
  margin-top: 0.75rem;
  font: 400 11px 'JetBrains Mono', monospace;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--ink-mute);
  padding: 0;
  transition: color 0.3s var(--ease-quiet);
}
.service-row:hover .order-btn { color: var(--neon-cyan); }

@media (max-width: 880px) {
  .service-row {
    grid-template-columns: 40px 1fr;
    gap: 1rem;
  }
  .service-row p, .service-row .price { grid-column: 2; }
  .service-row .price { text-align: left; margin-top: 0.5rem; }
}

/* Gallery */
#gallery {
  padding: 8rem 0;
  overflow: hidden;
  border-top: 1px solid var(--hair-mid);
}
.gallery-header { padding: 0 2rem; margin-bottom: 4rem; }
.parallax-strips {
  display: flex; flex-direction: column;
  gap: 1.25rem;
}
.parallax-row {
  display: flex;
  gap: 1.25rem;
  will-change: transform;
}
.parallax-row--bottom { transform: translateX(-150px); }
.parallax-item {
  width: 340px; height: 230px;
  flex-shrink: 0;
  position: relative;
  overflow: hidden;
  background: var(--void-card);
}
.parallax-item img {
  width: 100%; height: 100%;
  object-fit: cover;
  transition: transform 0.7s var(--ease-quiet), filter 0.5s var(--ease-quiet);
  filter: grayscale(35%) brightness(0.82);
}
.parallax-item:hover img {
  transform: scale(1.06);
  filter: grayscale(0%) brightness(1);
}
.parallax-item .meta {
  position: absolute;
  bottom: 1rem; left: 1rem;
  font: 400 10px 'JetBrains Mono', monospace;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: #fff;
  background: rgba(5,5,8,0.75);
  padding: 0.4rem 0.65rem;
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
}

/* Process */
#process {
  padding: 8rem 2rem;
  border-top: 1px solid var(--hair-mid);
}
.process-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 1rem;
}
.process-step {
  padding: 2rem 1.4rem;
  border: 1px solid var(--hair-mid);
  background: var(--void-dark);
  position: relative;
  transition: border-color 0.4s var(--ease-quiet), background 0.4s var(--ease-quiet);
}
.process-step:hover {
  border-color: var(--neon-cyan);
  background: rgba(0,212,255,0.05);
}
.process-step .step-num {
  font: 700 11px 'JetBrains Mono', monospace;
  letter-spacing: 0.2em;
  color: var(--neon-cyan);
  margin-bottom: 1.5rem;
}
.process-step h3 {
  font: 800 1.1rem/1.2 'Inter', sans-serif;
  letter-spacing: -0.01em;
  margin-bottom: 0.65rem;
}
.process-step p {
  font: 400 0.85rem/1.55 'Inter', sans-serif;
  color: var(--ink-mute);
}
.process-step .duration {
  margin-top: 1.25rem;
  font: 400 10px 'JetBrains Mono', monospace;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--ink-faint);
}
@media (max-width: 880px) { .process-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 540px) { .process-grid { grid-template-columns: 1fr; } }

/* Calculator */
#calculator {
  padding: 8rem 2rem;
  border-top: 1px solid var(--hair-mid);
  background: linear-gradient(180deg, transparent, rgba(0,212,255,0.03));
}
.calc-grid {
  display: grid;
  grid-template-columns: 1.4fr 1fr;
  gap: 3.5rem;
}
.calc-field { margin-bottom: 2rem; }
.calc-form label.field-label {
  display: block;
  font: 400 11px 'JetBrains Mono', monospace;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--ink-mute);
  margin-bottom: 0.75rem;
}
.radio-group {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
  gap: 0.65rem;
}
.radio-card {
  position: relative;
  display: block;
  padding: 1rem 1.15rem;
  border: 1px solid var(--hair-mid);
  background: var(--void-dark);
  transition: border-color 0.3s var(--ease-quiet), background 0.3s var(--ease-quiet);
}
.radio-card:hover { border-color: var(--hair-strong); }
.radio-card input {
  position: absolute;
  opacity: 0;
  pointer-events: none;
}
.radio-card:has(input:checked) {
  border-color: var(--neon-cyan);
  background: rgba(0,212,255,0.08);
}
.radio-card:has(input:checked) .card-name { color: var(--neon-cyan); }
.radio-card:has(input:checked) .card-price { color: var(--neon-soft); }
.card-name {
  font: 700 13px 'Inter', sans-serif;
  margin-bottom: 0.25rem;
  transition: color 0.3s var(--ease-quiet);
}
.card-price {
  font: 400 11px 'JetBrains Mono', monospace;
  color: var(--ink-mute);
  transition: color 0.3s var(--ease-quiet);
}
.input-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.25rem;
}
input[type="text"], input[type="number"], input[type="tel"], input[type="email"], select, textarea {
  width: 100%;
  background: var(--void-dark);
  border: 1px solid var(--hair-mid);
  color: #fff;
  padding: 0.85rem 1rem;
  font: 400 14px 'Inter', sans-serif;
  transition: border-color 0.3s var(--ease-quiet);
}
input:focus, select:focus, textarea:focus {
  outline: none;
  border-color: var(--neon-cyan);
}
textarea { min-height: 120px; resize: vertical; }

.checkbox-group {
  display: flex; flex-direction: column;
  gap: 0.65rem;
}
.check-row {
  display: flex; align-items: center; gap: 0.75rem;
  padding: 0.85rem 1rem;
  border: 1px solid var(--hair-mid);
  background: var(--void-dark);
  transition: border-color 0.3s var(--ease-quiet);
}
.check-row:hover { border-color: var(--hair-strong); }
.check-row input {
  width: 16px; height: 16px;
  accent-color: var(--neon-cyan);
}
.check-row label {
  margin: 0;
  font: 400 13px 'Inter', sans-serif;
  color: var(--ink-soft);
  text-transform: none;
  letter-spacing: 0;
}

.calc-actions {
  display: flex; gap: 1rem; flex-wrap: wrap;
  margin-top: 1.5rem;
}

.calc-result {
  position: sticky;
  top: 110px;
  padding: 2rem;
  border: 1px solid var(--hair-mid);
  background: var(--void-dark);
  align-self: start;
}
.calc-result h3 {
  font: 400 11px 'JetBrains Mono', monospace;
  letter-spacing: 0.25em;
  text-transform: uppercase;
  color: var(--neon-cyan);
  margin-bottom: 1.5rem;
}
.result-row {
  display: flex; justify-content: space-between;
  padding: 0.75rem 0;
  border-bottom: 1px solid var(--hair);
  font: 400 14px 'Inter', sans-serif;
  gap: 1rem;
}
.result-row .key { color: var(--ink-mute); }
.result-row .val {
  color: #fff;
  font-family: 'JetBrains Mono', monospace;
  font-size: 13px;
}
.result-total {
  display: flex; justify-content: space-between; align-items: baseline;
  padding: 1.5rem 0 0.5rem;
  margin-top: 1rem;
  border-top: 1px solid var(--hair-mid);
}
.result-total .key {
  font: 400 11px 'JetBrains Mono', monospace;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--ink-mute);
}
.result-total .val {
  font: 700 1.85rem 'JetBrains Mono', monospace;
  color: var(--neon-cyan);
  letter-spacing: -0.02em;
}
.result-empty {
  text-align: center;
  padding: 2rem 0;
  color: var(--ink-faint);
  font: 400 13px 'Inter', sans-serif;
  line-height: 1.5;
}
.result-cta {
  margin-top: 1.5rem;
  width: 100%;
  justify-content: center;
}
@media (max-width: 880px) {
  .calc-grid { grid-template-columns: 1fr; }
  .calc-result { position: static; }
}

/* Contact */
#contact {
  padding: 8rem 2rem;
  border-top: 1px solid var(--hair-mid);
}
.contact-grid {
  display: grid;
  grid-template-columns: 1fr 1.4fr;
  gap: 4rem;
}
.contact-info .info-block { margin-bottom: 2.25rem; }
.info-label {
  font: 400 11px 'JetBrains Mono', monospace;
  letter-spacing: 0.25em;
  text-transform: uppercase;
  color: var(--ink-mute);
  margin-bottom: 0.5rem;
}
.info-value {
  font: 400 1.15rem/1.5 'Inter', sans-serif;
  color: #fff;
}
