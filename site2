// ============= CALCULATOR =============
const PRICING = {
  flizelin: { name: 'Флизелин', unit: 350 },
  vinyl:    { name: 'Винил',    unit: 450 },
  photo:    { name: 'Фотообои', unit: 800 },
  freska:   { name: 'Фреска',   unit: 1200 },
  silk:     { name: 'Текстиль', unit: 950 },
};
const SERVICES = {
  prep:    { name: 'Подготовка стен',         unit: 200 },
  demo:    { name: 'Демонтаж старых обоев',   unit: 100 },
  ceiling: { name: 'Поклейка на потолок',     unit: 250 },
};

function formatRub(n) {
  return new Intl.NumberFormat('ru-RU').format(Math.round(n)) + ' ₽';
}

function calculate() {
  const wpInput = document.querySelector('input[name="wp-type"]:checked');
  const area = parseFloat(document.getElementById('calc-area').value) || 0;
  const prep = document.getElementById('calc-prep').checked;
  const demo = document.getElementById('calc-demo').checked;
  const ceiling = document.getElementById('calc-ceiling').checked;
  const urgency = document.getElementById('calc-urgency').checked;

  if (!wpInput) {
    showToast('warn', 'Не выбран тип обоев', 'Укажите материал в калькуляторе');
    return;
  }
  if (area <= 0) {
    showToast('warn', 'Не указана площадь', 'Введите площадь стен в м²');
    return;
  }

  const wp = PRICING[wpInput.value];
  const wpCost = wp.unit * area;
  const items = [{ key: wp.name + ' (поклейка)', val: wpCost }];

  if (prep) items.push({ key: SERVICES.prep.name, val: SERVICES.prep.unit * area });
  if (demo) items.push({ key: SERVICES.demo.name, val: SERVICES.demo.unit * area });
  if (ceiling) items.push({ key: SERVICES.ceiling.name, val: SERVICES.ceiling.unit * area });

  let total = items.reduce((s, i) => s + i.val, 0);
  if (urgency) {
    const urgencyCost = Math.round(total * 0.15);
    items.push({ key: 'Срочный выезд (+15%)', val: urgencyCost });
    total += urgencyCost;
  }

  renderResult(items, total, area, wp);
}

function renderResult(items, total, area, wp) {
  const body = document.getElementById('result-body');
  const rows = items.map(i => `
    <div class="result-row">
      <span class="key">${i.key}</span>
      <span class="val">${formatRub(i.val)}</span>
    </div>
  `).join('');
  body.innerHTML = `
    ${rows}
    <div class="result-total">
      <span class="key">Итого</span>
      <span class="val">${formatRub(total)}</span>
    </div>
    <button class="btn primary result-cta" id="result-order">Заказать с этой сметой<span class="arrow">→</span></button>
  `;
  const orderBtn = document.getElementById('result-order');
  if (orderBtn) {
    orderBtn.addEventListener('click', () => {
      const areaField = document.getElementById('f-area');
      if (areaField) areaField.value = area;
      const msg = document.getElementById('f-message');
      if (msg) msg.value = `Заявка из калькулятора. Тип: ${wp.name}, площадь: ${area} м², предварительная стоимость: ${formatRub(total)}.`;
      smoothScrollTo('#contact');
      showToast('success', 'Смета перенесена в форму', 'Заполните контакты и отправьте заявку');
    });
  }
}

function resetCalc() {
  document.querySelectorAll('input[name="wp-type"]').forEach(r => r.checked = false);
  document.getElementById('calc-area').value = '';
  document.getElementById('calc-height').value = '';
  ['calc-prep','calc-demo','calc-ceiling','calc-urgency'].forEach(id => {
    document.getElementById(id).checked = false;
  });
  document.getElementById('result-body').innerHTML = '<div class="result-empty">Заполните параметры слева — здесь появится детализированная смета.</div>';
}

document.getElementById('calc-calculate').addEventListener('click', calculate);
document.getElementById('calc-reset').addEventListener('click', resetCalc);

// ============= CONTACT FORM =============
function validatePhone(phone) {
  const cleaned = phone.replace(/[\s\-()]/g, '');
  return /^(\+7|8|7)?\d{10}$/.test(cleaned);
}
function showError(field, msg) {
  const el = document.querySelector(`[data-error-for="${field}"]`);
  if (el) el.textContent = msg;
}
function clearError(field) { showError(field, ''); }

document.getElementById('contact-form').addEventListener('submit', e => {
  e.preventDefault();
  const form = e.target;
  const name = form.name.value.trim();
  const phone = form.phone.value.trim();
  let valid = true;

  if (name.length < 2) { showError('name', 'Укажите имя (минимум 2 символа)'); valid = false; }
  else clearError('name');

  if (!validatePhone(phone)) { showError('phone', 'Укажите корректный телефон (10 цифр)'); valid = false; }
  else clearError('phone');

  if (!valid) {
    showToast('error', 'Проверьте поля', 'Имя и телефон обязательны');
    return;
  }

  const submitBtn = form.querySelector('button[type="submit"]');
  const original = submitBtn.innerHTML;
  submitBtn.innerHTML = 'Отправляем...';
  submitBtn.disabled = true;

  setTimeout(() => {
    showToast('success', 'Заявка принята', `Перезвоним в течение 2 часов, ${name}`);
    form.reset();
    submitBtn.innerHTML = original;
    submitBtn.disabled = false;
  }, 1200);
});

document.getElementById('f-name').addEventListener('input', e => {
  if (e.target.value.trim().length >= 2) clearError('name');
});
document.getElementById('f-phone').addEventListener('input', e => {
  if (validatePhone(e.target.value)) clearError('phone');
});

// ============= LIGHTBOX =============
const lightbox = document.getElementById('lightbox');
const lbImg = lightbox.querySelector('img');
const lbMeta = lightbox.querySelector('.lb-meta');

document.querySelectorAll('[data-lightbox]').forEach(item => {
  item.addEventListener('click', () => {
    const src = item.getAttribute('data-lightbox');
    const meta = item.getAttribute('data-meta');
    if (src) {
      lbImg.src = src;
      if (meta) lbMeta.textContent = meta;
      lightbox.classList.add('open');
    }
  });
});

lightbox.querySelector('.close').addEventListener('click', () => lightbox.classList.remove('open'));
lightbox.addEventListener('click', e => { if (e.target === lightbox) lightbox.classList.remove('open'); });
document.addEventListener('keydown', e => { if (e.key === 'Escape') lightbox.classList.remove('open'); });

// ============= TOAST =============
function showToast(type, title, body) {
  const container = document.getElementById('toast-container');
  const toast = document.createElement('div');
  toast.className = `toast ${type === 'success' ? '' : type}`;
  toast.innerHTML = `<div class="toast-title">${title}</div><div>${body}</div>`;
  container.appendChild(toast);
  setTimeout(() => {
    toast.classList.add('out');
    setTimeout(() => toast.remove(), 400);
  }, 4500);
}

// ============= REFRESH SCROLLTRIGGER ON FONTS =============
if (document.fonts && document.fonts.ready) {
  document.fonts.ready.then(() => {
    if (ScrollTrigger) ScrollTrigger.refresh();
  });
}

// Welcome toast
setTimeout(() => {
  showToast('success', 'Студия «Поверхности»', 'Прокрутите вниз, чтобы посмотреть работы');
}, 1800);

</script>
